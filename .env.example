# SkillSync Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# MongoDB connection
MONGO_URI=mongodb://mongodb:27017
DATABASE_NAME=skillsync

# Scraper settings
SCRAPE_INTERVAL_HOURS=12
LOG_LEVEL=INFO

# Selenium settings
HEADLESS=true

# Optional: Rozee.pk session cookie for CAPTCHA bypass
# Update this periodically if Rozee.pk requires CAPTCHA
ROZEE_SESSION_COOKIE=
