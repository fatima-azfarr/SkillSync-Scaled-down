# SkillSync Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# MongoDB connection
MONGO_URI=mongodb://mongodb:27017
DATABASE_NAME=skillsync

# Scraper settings
SCRAPE_INTERVAL_HOURS=12
LOG_LEVEL=INFO

# Selenium settings
HEADLESS=true

# Optional: Rozee.pk session cookie for CAPTCHA bypass
# Update this periodically if Rozee.pk requires CAPTCHA
ROZEE_SESSION_COOKIE=

# Security & Authentication
JWT_SECRET_KEY=generate_a_secure_random_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
